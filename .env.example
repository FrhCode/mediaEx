# Copy to .env next to compose.yaml (build from source) or compose.deploy.yaml
# (pull the published image). All three values below are required either way.
# Portainer: paste the KEY=VALUE lines into the stack's Environment variables
# (Advanced mode) instead — no .env file needed there.
MEDIA_HOST_PATH=/mnt/nas/media
ADMIN_NAME=admin
ADMIN_PASSWORD=
PORT=8080
# Used only by compose.deploy.yaml — pin the version you want that machine to run:
# MEDIAEX_IMAGE=farhan100799/mediaex:1.0.0

# ADMIN_PASSWORD must contain at least 12 characters.
# Bootstrap credentials create the first admin only; they never reset existing accounts.
SCAN_INTERVAL=15m
SCAN_SETTLE=30s
# Probe/thumbnail deadline; sprite generation has its own longer deadline.
TOOL_TIMEOUT=30s
SPRITE_TIMEOUT=2m
# One conversion at a time; output is stored in DATA_DIR, originals remain untouched.
CONVERT_TIMEOUT=2h

# Optional relative file already present on the NAS; missing marker aborts scans safely.
MEDIA_MARKER=

# Keep false when the app is reached over plain HTTP or through an SSH tunnel,
# which already encrypts the traffic. Set true only behind an HTTPS reverse proxy,
# otherwise sign-in silently fails because the browser drops the cookie.
COOKIE_SECURE=false
# Set to the browser's exact external HTTPS origin for passkeys and app lock.
# Use a stable hostname and a certificate trusted by the device; pair with COOKIE_SECURE=true.
# Local development may use http://localhost:<port>.
PUBLIC_ORIGIN=
# Caddy HTTPS requires COOKIE_SECURE=true and the exact HTTPS PUBLIC_ORIGIN together.
# Optional CIDRs of the immediate proxy, to rate-limit by client IP instead of Caddy.
# Use the narrowest Docker network/proxy range; never trust arbitrary public ranges.
TRUSTED_PROXIES=
